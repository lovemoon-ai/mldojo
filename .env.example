# docker compose settings. Copy to .env (gitignored) and fill in.
# Database password (required; URL-safe characters, e.g. `openssl rand -hex 16`).
POSTGRES_PASSWORD=
# Address agents on your nodes use to reach the API.
MLDOJO_PUBLIC_URL=http://localhost:8765
# Optional: fixed API token / secrets master key (otherwise generated in the data volume).
MLDOJO_TOKEN=
MLDOJO_MASTER_KEY=
# Optional queue plugins: name=sidecar-url[,name2=url2]
MLDOJO_QUEUE_PLUGINS=
