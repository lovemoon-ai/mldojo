# Site-specific settings for one MLDojo deployment. Copy to deploy/site.env
# (gitignored) and fill in. Plain KEY=value lines, no quotes: both the
# Makefile and deploy/native/install.sh read this file.

# URL agents and users reach the API at (written to config.yaml on first
# install; also rendered into the served SKILL.md).
MLDOJO_PUBLIC_URL=
# Optional second address, for nodes that cannot reach MLDOJO_PUBLIC_URL
# (e.g. an intranet address). Rendered into SKILL.md.
MLDOJO_INTRANET_URL=
# Default --server baked into the CLI by `make build` (default http://localhost:8765).
MLDOJO_DEFAULT_SERVER=
# Space-separated checkouts of queue plugins; install.sh runs <dir>/install.sh
# for each (see docs/queue-plugins.md).
MLDOJO_PLUGIN_DIRS=
